# Local development defaults. Copy to .env and adjust for your environment.

RPC_URL=http://127.0.0.1:8545
# Every call to the node fails after this long, from the request to the last byte of the reply, as a refused
# connection does; a node that accepts a request and never answers no longer holds the caller. Keep it above the
# node's slowest legitimate call, with ENABLE_TRACING its slowest debug_traceBlockByNumber
# (indexer_rpc_request_duration_seconds, by method). Must be above 0.
RPC_TIMEOUT=60s
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chain_indexer?sslmode=disable
GRPC_LISTEN_ADDR=:50051

METRICS_ENABLED=true
METRICS_LISTEN_ADDR=:8080
PPROF_ENABLED=false
PPROF_LISTEN_ADDR=:6060

POLL_INTERVAL=2s
START_BLOCK=0
LOG_LEVEL=info

RPC_WORKERS=50
RPC_RATE_LIMIT=500
DB_BATCH_SIZE=500
TOKEN_METADATA_WORKERS=20
BALANCE_WORKERS=30
ENABLE_ASYNC_BALANCE=true

ENABLE_TRACING=false
TRACE_RATE_LIMIT=50
TRACE_WORKERS=10

CATCHUP_ENABLED=true
CATCHUP_WORKERS=10
CATCHUP_BATCH_SIZE=100
CATCHUP_QUEUE_SIZE=1000

HIDDEN_TX_TYPES=126
REBUILD_WORK_MEM=1GB
# Minimum time between two daily_stats advances (each folds the blocks stored since the last into their days);
# 0 = advance on every 100th block.
DAILY_STATS_MIN_INTERVAL=60s

# Blocks the standard loop writes at once; 1 = one after another. Each open block holds a database connection, so
# the indexer refuses to start unless COMMIT_PIPELINE + BALANCE_WORKERS (when ENABLE_ASYNC_BALANCE is true) + 2 fits
# in the pool's maximum connections (pool_max_conns in DATABASE_URL; pgx defaults to the larger of 4 and the CPU
# count). 1 always starts.
COMMIT_PIPELINE=1
# Hold each (address, token) balance read this long and fetch it once at the latest block; 0s = fetch every one.
BALANCE_DEDUP_WINDOW=0s
# Read up to this many balances of one token per eth_call through a reader contract injected with a state
# override; the node must support eth_call state overrides. 0 = one call per balance.
BALANCE_READER_BATCH=0
# Arbitrum Nitro only: send skipL1Charging with the batched balance call.
BALANCE_SKIP_L1=false
# Keep an index on tx_hash in logs and token_transfers for consumers that read them by transaction hash.
TX_HASH_INDEXES=true

# History retention. Keep this many blocks below the stored head and drop older history by whole partitions;
# 0 keeps everything. At least 12,800 when set. START_BLOCK above 0 cannot be combined with retention. Every UTC day a
# reorg can reach is kept whole, so up to a day more than this is kept.
PRUNE_RETAIN_BLOCKS=0
# Blocks per history partition; 0 = PRUNE_RETAIN_BLOCKS / 10.
PARTITION_BLOCKS=0
# How often retention cuts, keeps partitions ahead of the head and drops ranges below the window.
PRUNE_INTERVAL=1m
# When set, a range is archived to this directory before it is dropped.
PRUNE_ARCHIVE_DIR=
# With retention on, serve blocks and transactions below the prune watermark from the node instead of answering
# OutOfRange / NotFound, through a bounded cache.
PRUNED_LOOKUP=false
PRUNED_LOOKUP_CACHE_BLOCKS=2000
PRUNED_LOOKUP_CACHE_MB=256
PRUNED_LOOKUP_TIMEOUT=5s
PRUNED_LOOKUP_CONCURRENCY=4

# The totals ledger, kept with retention on or off: blocks per span, how often a span is closed, the closing
# transaction's work_mem, and how far ingest may be behind the node before the closer waits (0 = never waits). On an
# upgraded database the closer covers the whole history once, in the background.
LEDGER_SPAN_BLOCKS=100000
LEDGER_CLOSE_INTERVAL=10s
LEDGER_WORK_MEM=512MB
LEDGER_MAX_HEAD_LAG_BLOCKS=0

# Realtime further behind the node than this jumps to the head and leaves the skipped blocks to catch-up; 0 never
# jumps, as 0.4.0. 1000 is the tested value.
REALTIME_MAX_BEHIND_BLOCKS=0

# Subcommands (run the indexer binary with the name first; each prints its plan first, see --help):
#   repair-address-stats [--batch 1000] [--dry-run]
#       sets address_stats to what the closed ledger and the retained rows say, then recounts the days' address
#       columns; run once after upgrading a database that was interrupted in its initial sync or has seen reorgs.
#   refill-daily-stats --from YYYY-MM-DD --to YYYY-MM-DD [--bodies] [--receipts] [--rate 2] [--batch 100] [--plan]
#                      [--dry-run] [--recompute-only]
#       recounts days whose blocks never reached daily_stats, from the node.
#   backfill-contracts [--csv FILE|-] [--rate 5] [--no-trace]
#       records contracts created by other contracts in blocks indexed before this release.

ENABLE_OP_DEPOSITS=false
L1_RPC_URL=
OPTIMISM_PORTAL_ADDRESS=
L1_DEPOSIT_POLL_INTERVAL=12s
L1_DEPOSIT_BATCH_SIZE=1000
L1_DEPOSIT_START_BLOCK=0
